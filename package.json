{
  "name": "planes-above",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PlanesAbove - Himmel ueber dem Haus. Design system (Storybook) plus future home-server service and client.",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "build": "npm run assets && node scripts/build.mjs",
    "start": "node dist/server/server.mjs",
    "pretest": "npm run assets",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stats:routes": "node scripts/stats-routes.mjs",
    "stats:liveries": "node scripts/stats-liveries.mjs",
    "storybook": "npm run assets && storybook dev -p 6006",
    "build-storybook": "npm run assets && storybook build -o storybook-static",
    "pretest:e2e": "npm run build-storybook && npm run build",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@storybook/html-vite": "^10.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "storybook": "^10.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
